    <recordCreates>
        <name>Create_History_Tracking_for_Amount</name>
        <label>Create History Tracking for Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Field_Name__c</field>
            <value>
